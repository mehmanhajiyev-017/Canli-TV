<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Полноэкранный ТВ Плеер -->
    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:clickable="false"
        app:use_controller="false" />

    <!-- Status və Sürət Paneli (3x OK) -->
    <LinearLayout
        android:id="@+id/syncStatusCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSyncChannels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Каналы: 0"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSyncLogos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Логотипы: 0"
            android:textColor="#B0BEC5"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvSyncPrograms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Программы: 0"
            android:textColor="#B0BEC5"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvSyncSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Скорость: 0.00 Мбит/с"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Sol panel: Kateqoriyalar -->
    <LinearLayout
        android:id="@+id/categoryPanel"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:background="#E80D111A"
        android:orientation="vertical"
        android:padding="20dp"
        android:elevation="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:paddingStart="4dp"
            android:text="Категории"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewCategories"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

        <LinearLayout
            android:id="@+id/btnOpenSettings"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙"
                android:textColor="#B0BEC5"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Настройки"
                android:textColor="#ECEFF1"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sol panel: Kanal siyahısı -->
    <LinearLayout
        android:id="@+id/channelPanel"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:background="#F00D111A"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="10dp"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- Aşağı panel: Kanal info banneri -->
    <LinearLayout
        android:id="@+id/infoBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="28dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:elevation="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBannerNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="1"
                android:textColor="#2979FF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgBannerLogo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="16dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvBannerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Имя канала"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBannerCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Категория"
            android:textColor="#B0BEC5"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Sağ panel: Numpad -->
    <LinearLayout
        android:id="@+id/numPadPanel"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="32dp"
        android:orientation="vertical"
        android:padding="18dp"
        android:elevation="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNumpadDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center"
            android:text="---"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4">

            <Button android:id="@+id/btn1" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="1" android:textSize="18sp" />
            <Button android:id="@+id/btn2" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="2" android:textSize="18sp" />
            <Button android:id="@+id/btn3" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="3" android:textSize="18sp" />

            <Button android:id="@+id/btn4" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="4" android:textSize="18sp" />
            <Button android:id="@+id/btn5" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="5" android:textSize="18sp" />
            <Button android:id="@+id/btn6" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="6" android:textSize="18sp" />

            <Button android:id="@+id/btn7" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="7" android:textSize="18sp" />
            <Button android:id="@+id/btn8" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="8" android:textSize="18sp" />
            <Button android:id="@+id/btn9" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="9" android:textSize="18sp" />

            <Button android:id="@+id/btnClear" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="C" android:textColor="#FF5252" android:textSize="18sp" />
            <Button android:id="@+id/btn0" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="0" android:textSize="18sp" />
            <Button android:id="@+id/btnGo" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="OK" android:textColor="#4CAF50" android:textSize="18sp" />
        </GridLayout>
    </LinearLayout>

    <!-- Ayarlar Pəncərəsi (Mərkəzləşdirilmiş və səliqəli) -->
    <RelativeLayout
        android:id="@+id/linkDialogPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:elevation="20dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/settingsContainerBox"
            android:layout_width="650dp"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="#F7121722"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Настройки плейлиста и EPG"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ссылка на плейлист M3U / M3U8:"
                android:textColor="#B0BEC5"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etM3uUrl"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="http://.../playlist.m3u"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSaveM3u"
                    android:layout_width="130dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:text="СОХРАНИТЬ"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRefreshM3u"
                    android:layout_width="54dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:text="↻"
                    android:textSize="20sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ссылка на телегид EPG (.xml / .gz):"
                android:textColor="#B0BEC5"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etEpgUrl"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="https://epg.one/epg.xml.gz"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSaveEpg"
                    android:layout_width="130dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:text="СОХРАНИТЬ"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRefreshEpg"
                    android:layout_width="54dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:text="↻"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCloseSettings"
                    android:layout_width="150dp"
                    android:layout_height="52dp"
                    android:text="ЗАКРЫТЬ"
                    android:textColor="#ECEFF1"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
