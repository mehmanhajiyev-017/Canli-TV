<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Əsas Video Pleyer -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <!-- Sol Tərəf: Kanal Siyahısı -->
    <LinearLayout
        android:id="@+id/channelPanel"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:background="#E6121418"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Canlı Kanallar"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTotalChannels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="0 kanal mövcuddur"
            android:textColor="#888888"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true" />
    </LinearLayout>

    <!-- Sağ Tərəf: Rəqəmli Axtarış Paneli -->
    <LinearLayout
        android:id="@+id/numPadPanel"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="30dp"
        android:background="#F0181A20"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kanal Nömrəsi"
            android:textColor="#00E5FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNumpadDisplay"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:background="#252830"
            android:gravity="center"
            android:text="---"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- 1, 2, 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btn1" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="1" android:textColor="#FFF" android:textSize="20sp" />
            <Button android:id="@+id/btn2" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="2" android:textColor="#FFF" android:textSize="20sp" />
            <Button android:id="@+id/btn3" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="3" android:textColor="#FFF" android:textSize="20sp" />
        </LinearLayout>

        <!-- 4, 5, 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btn4" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="4" android:textColor="#FFF" android:textSize="20sp" />
            <Button android:id="@+id/btn5" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="5" android:textColor="#FFF" android:textSize="20sp" />
            <Button android:id="@+id/btn6" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="6" android:textColor="#FFF" android:textSize="20sp" />
        </LinearLayout>

        <!-- 7, 8, 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btn7" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="7" android:textColor="#FFF" android:textSize="20sp" />
            <Button android:id="@+id/btn8" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="8" android:textColor="#FFF" android:textSize="20sp" />
            <Button android:id="@+id/btn9" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="9" android:textColor="#FFF" android:textSize="20sp" />
        </LinearLayout>

        <!-- C, 0, OK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnClear" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="C" android:textColor="#FF5252" android:textSize="18sp" />
            <Button android:id="@+id/btn0" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="0" android:textColor="#FFF" android:textSize="20sp" />
            <Button android:id="@+id/btnGo" style="@style/Widget.AppCompat.Button.Borderless" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="OK" android:textColor="#00E5FF" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Aşağı Hissə: Soldan Sağa BÜTÖV Şəffaf Panel (Xiaomi TV+ Stili) -->
    <LinearLayout
        android:id="@+id/infoBanner"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="bottom"
        android:background="#E6101216"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:visibility="gone">

        <!-- Nömrə Kartı -->
        <TextView
            android:id="@+id/tvBannerNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#00E5FF"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:text="001"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Kanal Loqosu -->
        <ImageView
            android:id="@+id/imgBannerLogo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="24dp"
            android:scaleType="fitCenter" />

        <!-- Kanal Adı və Canlı Yayın Yazısı -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBannerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Kanal Adı"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="● CANLI YAYIN"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- M3U Link Daxil Etmə Pəncərəsi -->
    <LinearLayout
        android:id="@+id/linkDialogPanel"
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#F0181A20"
        android:orientation="vertical"
        android:padding="26dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="M3U Pleylist Quraşdırması"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etM3uUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#252830"
            android:hint="https://example.com/playlist.m3u"
            android:inputType="textUri"
            android:padding="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#757575" />

        <Button
            android:id="@+id/btnSaveUrl"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#00E5FF"
            android:text="Yadda Saxla və Başla"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
