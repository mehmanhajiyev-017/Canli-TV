<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false"
        app:use_controller="false" />

    <LinearLayout
        android:id="@+id/mobileTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="#CC0B0E14"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnMobileCategories"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="#33FFFFFF"
            android:text="📁 Группы"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMobileChannels"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="#33FFFFFF"
            android:text="📺 Каналы"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnMobileSettings"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="#33FFFFFF"
            android:text="⚙ Настройки"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/syncStatusCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSyncChannels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Каналы: 0"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSyncLogos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Логотипы: 0"
            android:textColor="#B0BEC5"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSyncPrograms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Программы: 0"
            android:textColor="#B0BEC5"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/categoryPanel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:background="#F20B0E14"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Группы каналов"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewCategories"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/btnOpenSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙"
                android:textColor="#B0BEC5"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Настройки"
                android:textColor="#ECEFF1"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/channelPanel"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:background="#F70B0E14"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/infoBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:background="#E60B0E14"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBannerNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:text="1"
                android:textColor="#2979FF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgBannerLogo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="14dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvBannerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Имя канала"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBannerCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Группа"
            android:textColor="#B0BEC5"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/numPadPanel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNumpadDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="---"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4">

            <Button android:id="@+id/btn1" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="1" android:textSize="18sp" />
            <Button android:id="@+id/btn2" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="2" android:textSize="18sp" />
            <Button android:id="@+id/btn3" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="3" android:textSize="18sp" />

            <Button android:id="@+id/btn4" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="4" android:textSize="18sp" />
            <Button android:id="@+id/btn5" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="5" android:textSize="18sp" />
            <Button android:id="@+id/btn6" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="6" android:textSize="18sp" />

            <Button android:id="@+id/btn7" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="7" android:textSize="18sp" />
            <Button android:id="@+id/btn8" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="8" android:textSize="18sp" />
            <Button android:id="@+id/btn9" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="9" android:textSize="18sp" />

            <Button android:id="@+id/btnClear" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="C" android:textColor="#FF5252" android:textSize="18sp" />
            <Button android:id="@+id/btn0" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="0" android:textSize="18sp" />
            <Button android:id="@+id/btnGo" style="?android:attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="OK" android:textColor="#4CAF50" android:textSize="18sp" />
        </GridLayout>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/linkDialogPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:background="#1B222E"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Настройки приложения"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Ссылка на плейлист M3U:"
                android:textColor="#B0BEC5"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etM3uUrl"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:hint="http://.../playlist.m3u"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSaveM3u"
                    android:layout_width="95dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:text="СОХРАНИТЬ"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRefreshM3u"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:text="↻"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Ссылка на EPG телегид (.xml / .gz):"
                android:textColor="#B0BEC5"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etEpgUrl"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:hint="http://.../epg.xml.gz"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSaveEpg"
                    android:layout_width="95dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:text="СОХРАНИТЬ"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRefreshEpg"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:text="↻"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnToggleMode"
                    android:layout_width="54dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_mode_tv" />

                <Button
                    android:id="@+id/btnCloseSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="ЗАКРЫТЬ"
                    android:textColor="#ECEFF1"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
